#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        mouse_move {
            bindings = <&mkp MCLK>;
            key-positions = <14 13>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&trans  &trans     &trans            &trans              &trans     &trans                                                             &trans       &trans  &trans            &trans         &trans          &trans
&trans  &kp Q      &kp W             &kp E               &kp R      &kp T                                                              &kp Y        &kp U   &kp I             &kp O          &mt ESC EQUAL   &trans
&trans  &kp A      &kp S             &kp D               &kp F      &kp G      &trans                    &trans                        &kp H        &kp J   &kp K             &kp L          &kp P           &trans
&trans  &kp Z      &kp X             &kp C               &kp V      &kp B      &mt LEFT_BRACKET MINUS    &mt RIGHT_BRACKET UNDERSCORE  &kp N        &kp M   &kp SINGLE_QUOTE  &kp SEMICOLON  &kp PERIOD      &trans
&trans  &kp LCTRL  &mt LEFT_WIN TAB  &mt LEFT_ALT SPACE  &mkp LCLK  &mkp RCLK  &mt LEFT_SHIFT BACKSPACE  &lt 1 COMMA                   &lt 2 ENTER  &trans  &trans            &trans         &mt CLCK SLASH  &trans
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans              &trans               &trans      &trans      &trans                                            &trans          &trans        &trans        &trans        &trans         &trans
&trans  &kp LS(NUMBER_1)    &kp LS(NUMBER_2)     &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                                        &kp LS(N6)      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0         &trans
&trans  &kp LS(NUMBER_6)    &kp LS(N7)           &kp LS(N8)  &kp LS(N9)  &kp LS(N0)      &trans           &trans           &kp LEFT_BRACE  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp COLON      &trans
&trans  &kp LS(LEFT_BRACE)  &kp LS(RIGHT_BRACE)  &kp LS(N9)  &kp LS(N0)  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp RIGHT_BRACE  &kp LS(MINUS)   &kp N7        &kp N8        &kp N9        &kp BACKSLASH  &trans
&trans  &trans              &trans               &trans      &trans      &trans          &trans           &kp TAB          &bt BT_CLR_ALL  &trans        &trans        &trans        &trans         &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans   &trans   &trans        &trans        &trans                                &trans           &trans           &trans            &trans     &trans      &trans
&trans  &kp F1   &kp F2   &kp F3        &kp F4        &kp F5                                &kp HOME         &kp PG_UP        &kp UP            &kp END    &kp ESCAPE  &trans
&trans  &kp F6   &kp F7   &kp F8        &kp F9        &kp F10     &trans  &trans            &kp LEFT         &kp LEFT_ARROW   &kp DOWN_ARROW    &kp RIGHT  &kp TAB     &trans
&trans  &kp F11  &kp F12  &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &trans  &msc MOVE_X(-20)  &msc MOVE_X(20)  &msc MOVE_Y(20)  &msc MOVE_Y(-20)  &trans     &kp PIPE    &trans
&trans  &trans   &trans   &trans        &mkp MB4      &mkp MB5    &trans  &trans            &bt BT_CLR_ALL   &trans           &trans            &trans     &trans      &trans
            >;
        };
    };
};
